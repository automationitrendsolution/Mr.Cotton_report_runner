# Copy to .env and fill in.
AMAZON_ADS_EMAIL=
AMAZON_ADS_PASSWORD=
# Optional: the authenticator-app secret key (shown as "Can't scan the barcode?" when adding an
# authenticator app under Login & security -> 2-Step Verification). With it, OTP is fully automatic.
AMAZON_ADS_TOTP_SECRET=

REPORTING_URL=https://advertising.amazon.com/reporting?entityId=ENTITY1YST5GXMAIR36
TODAY_REPORT_ID=cbaf9b24-4e76-4ab5-805d-3a48d930fa5d
YESTERDAY_REPORT_ID=d66eeaf9-671b-4c4b-aa1a-b76931c5c9a2
# Only for --report auto: IST time from which "Mr.cotton today" runs (until midnight); before it "Mr.cotton yesterday" runs.
TODAY_FROM_IST=12:30
HEADLESS=true
# Extra attempts when a step fails because of a slow page or network blip (0 = no retries).
RETRIES=2
